	note = {arXiv:1806.05743 [cond-mat]},
	keywords = {Condensed Matter - Disordered Systems and Neural Networks, Condensed Matter - Statistical Mechanics},
	pages = {012301},
	annote = {Comment: 57 pages, 11 figures, 7 tables},
	file = {arXiv.org Snapshot:/Users/shreeyam/Zotero/storage/S2QS88TU/1806.html:text/html;Submitted Version:/Users/shreeyam/Zotero/storage/TD5668PU/Katzav et al. - 2018 - The distribution of shortest path lengths in subcr.pdf:application/pdf},
}

