	keywords = {Satellites, Clouds, Aqua, cloud remote sensing, clouds, Histograms, Ice, Integrated optics, Moderate Resolution Imaging Spectroradiometer (MODIS), MODIS, Optical sensors, satellite applications, Terra, terrestrial atmosphere},
	pages = {3826--3852},
	file = {IEEE Xplore Abstract Record:/Users/shreeyam/Zotero/storage/IMIRX7AL/6422379.html:text/html;IEEE Xplore Full Text PDF:/Users/shreeyam/Zotero/storage/D34H4G2B/King et al. - 2013 - Spatial and Temporal Distribution of Clouds Observed by MODIS Onboard the Terra and Aqua Satellites.pdf:application/pdf},
