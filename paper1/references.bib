	month = mar,
	year = {2025},
	keywords = {Space vehicles, CubeSat, Graphics processing units, Automotive engineering, Computers, Connectors, Nonvolatile memory, Random access memory, System-on-chip, Universal Serial Bus},
	pages = {1--12},
	file = {Full Text PDF:/Users/shreeyam/Zotero/storage/TRV8KQEG/Ogbe et al. - 2025 - The JPL Snapdragon Co-Processor A Compact High-Performance Computer for Spaceflight Applications.pdf:application/pdf},
