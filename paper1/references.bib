@inproceedings{marin_phi-sat-2_2021,
	title = {Phi-{Sat}-2: {Onboard} {AI} {Apps} for {Earth} {Observation}},
	shorttitle = {Phi-{Sat}-2},
	abstract = {Following the success of the Φ-Sat mission, the European Space Agency (ESA) announced the opportunity to present CubeSat-based ideas for the Φ-Sat 2 mission to promote innovative technologies such as Artificial Intelligence (AI) capabilities onboard Earth Observation (EO) missions. The Φ-Sat-2 mission-idea, submitted jointly by Open Cosmos and CGI, leverages the latest research and developments in the European ecosystem: a game-changing EO CubeSat platform capable of running AI Apps that can be developed, uploaded and deployed and orchestrated on the spacecraft and updated during flight operations: the NanoSat MO Framework, to deploy in space AI as simple Apps, similar to Android apps, controlling sensor and AI accelerator processors. The Φ-Sat-2 Mission, will be used to demonstrate the AI enabling capability for innovative EO techniques, fostering novel architectures to meet user-driven science and applications by means of on-board processing. A set of default Apps: cloud detection, vessel detection, image compression, and roadmap transformation will be available; furthermore third-party Apps will be included on later stages of the mission lifecycle. This paper presents the Φ-Sat-2 mission objectives and how the different AI applications orchestrated by the NanoSat MO Framework, will demonstrate the disruptive advantages that the onboard AI brings to the mission.},
